<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your order is confirmed</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f6f8fa;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f6f8fa;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d9e0;">
            <tr>
              <td style="padding:24px; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; color:#1f2328;">
                <h1 style="margin:0 0 16px; font-size:22px; line-height:28px; color:#1f2328;">Thanks, {{customerName}}</h1>
                <p style="margin:0 0 16px;">Your order <strong>{{reference}}</strong> is confirmed: {{quantity}} × {{sku}}.</p>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="background-color:#0b5cad; border-radius:4px;">
                      <a href="{{orderUrl}}" style="display:inline-block; padding:12px 20px; font-family:Arial, Helvetica, sans-serif; font-size:16px; color:#ffffff; text-decoration:none;">View your order</a>
                    </td>
                  </tr>
                </table>
                <p style="margin:16px 0 0; font-size:14px; line-height:20px; color:#59636e;">If the button does not work, open {{orderUrl}}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
